{
  "id": "premium-redirection-fund-switch",
  "title": "Premium Redirection and Fund Switch",
  "description": "Redirect future renewal premiums, switch accumulated units between funds, or request both.",
  "pdf": "premium-redirection-fund-switch.pdf",
  "sections": [
    {
      "id": "policyowner",
      "title": "Policyowner details",
      "questions": [
        {
          "id": "policy_number",
          "q": "Policy number",
          "type": "text",
          "required": true,
          "map": [
            {
              "comb": [
                "POLICYNUMBER-1.0",
                "POLICYNUMBER-1.1",
                "POLICYNUMBER-1.2",
                "POLICYNUMBER-1.3",
                "POLICYNUMBER-1.4",
                "POLICYNUMBER-1.5",
                "POLICYNUMBER-1.6",
                "POLICYNUMBER-1.7"
              ]
            }
          ]
        },
        {
          "id": "surname",
          "q": "Surname",
          "type": "text",
          "required": true,
          "map": [
            {
              "text": "NAME-A5.0.0---ALPHA-1"
            }
          ]
        },
        {
          "id": "given_name",
          "q": "Given name",
          "type": "text",
          "required": true,
          "map": [
            {
              "text": "-2"
            }
          ]
        },
        {
          "id": "middle_name",
          "q": "Middle name",
          "type": "text",
          "map": [
            {
              "text": "NAME-A5.0.0---ALPHA"
            }
          ]
        },
        {
          "id": "alias",
          "q": "Other legal name / alias",
          "type": "text",
          "map": [
            {
              "text": "NAME-A5.0.0"
            }
          ]
        },
        {
          "id": "dob",
          "q": "Date of birth",
          "type": "date",
          "required": true,
          "map": [
            {
              "comb": [
                "DOB-1.0",
                "DOB-1.1",
                "DOB-1.2",
                "DOB-1.3",
                "DOB-1.4",
                "DOB-1.5",
                "DOB-1.6",
                "DOB-1.7"
              ],
              "format": "date_digits"
            }
          ]
        },
        {
          "id": "nationality",
          "q": "Nationality",
          "type": "text",
          "required": true,
          "map": [
            {
              "text": "NUMBER-1.2"
            }
          ]
        },
        {
          "id": "mobile",
          "q": "Mobile number",
          "type": "phone",
          "required": true,
          "map": [
            {
              "text": "NUMBER-1.0"
            }
          ]
        },
        {
          "id": "telephone",
          "q": "Telephone number",
          "type": "phone",
          "map": [
            {
              "text": "NUMBER-1.1"
            }
          ]
        },
        {
          "id": "occupation",
          "q": "Occupation and exact duties (AFP/PNP: include rank)",
          "type": "text",
          "map": [
            {
              "text": "NAME-A5.0.1"
            }
          ]
        },
        {
          "id": "employer",
          "q": "Employer / business name",
          "type": "text",
          "map": [
            {
              "text": "NAME-A5.1.1"
            }
          ]
        },
        {
          "id": "personal_changes",
          "q": "Have your personal details changed in Pru Life UK records?",
          "type": "radio",
          "required": true,
          "options": [
            {
              "value": "yes",
              "label": "Yes"
            },
            {
              "value": "no",
              "label": "No"
            }
          ],
          "map": [
            {
              "radio": "Check Box5-OH-OH",
              "valueMap": {
                "yes": "Yes",
                "no": "2"
              }
            }
          ]
        },
        {
          "id": "request_type",
          "q": "What would you like to request?",
          "type": "radio",
          "required": true,
          "options": [
            {
              "value": "redirection",
              "label": "Premium redirection"
            },
            {
              "value": "switch",
              "label": "Fund switch"
            },
            {
              "value": "both",
              "label": "Both"
            }
          ],
          "map": []
        }
      ]
    },
    {
      "id": "redirection",
      "title": "Premium redirection",
      "showIf": {
        "q": "request_type",
        "in": [
          "redirection",
          "both"
        ]
      },
      "intro": "Redirect future renewal premiums. Allocations must total 100%, in multiples of 5%. The new direction takes effect on the next premium payment.",
      "questions": [
        {
          "id": "redirection_count",
          "q": "How many fund allocations?",
          "type": "radio",
          "required": true,
          "options": [
            {
              "value": "1",
              "label": "1"
            },
            {
              "value": "2",
              "label": "2"
            },
            {
              "value": "3",
              "label": "3"
            },
            {
              "value": "4",
              "label": "4"
            }
          ],
          "map": []
        },
        {
          "id": "fund_0",
          "q": "Fund 1: name",
          "type": "text",
          "required": true,
          "showIf": {
            "q": "redirection_count",
            "gte": 1
          },
          "map": [
            {
              "text": "TEXT TEXT AW.0"
            }
          ]
        },
        {
          "id": "allocation_0",
          "q": "Fund 1: percentage",
          "type": "number",
          "required": true,
          "showIf": {
            "q": "redirection_count",
            "gte": 1
          },
          "help": "Enter a multiple of 5, without %. All allocations must total 100%.",
          "map": [
            {
              "text": "TEXT TEXT AW-B.0"
            }
          ]
        },
        {
          "id": "fund_1",
          "q": "Fund 2: name",
          "type": "text",
          "required": true,
          "showIf": {
            "q": "redirection_count",
            "gte": 2
          },
          "map": [
            {
              "text": "TEXT TEXT AW.1"
            }
          ]
        },
        {
          "id": "allocation_1",
          "q": "Fund 2: percentage",
          "type": "number",
          "required": true,
          "showIf": {
            "q": "redirection_count",
            "gte": 2
          },
          "help": "Enter a multiple of 5, without %. All allocations must total 100%.",
          "map": [
            {
              "text": "TEXT TEXT AW-B.1"
            }
          ]
        },
        {
          "id": "fund_2",
          "q": "Fund 3: name",
